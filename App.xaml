<Application x:Class="SecretChat.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="Ink">#FFF7F8FC</Color><Color x:Key="Muted">#FF8C92A5</Color><Color x:Key="Panel">#FF151722</Color><Color x:Key="Line">#25FFFFFF</Color><Color x:Key="Accent">#FF8B83FF</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/><SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/><SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/></Style>
  </Application.Resources>
</Application>
