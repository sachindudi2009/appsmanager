<Window x:Class="SecretChat.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Secret Chat" Width="860" Height="620" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen" Background="#FF090A10" Foreground="#FFF7F8FC" FontFamily="Segoe UI Variable Display, Segoe UI" WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" StateChanged="Window_StateChanged" Closing="Window_Closing">
  <Border BorderBrush="#338B83FF" BorderThickness="1" CornerRadius="14" Background="#FF090A10">
    <Grid ClipToBounds="True"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FF10111A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><DockPanel Margin="12,0,6,0"><TextBlock Text="●  SECRET CHAT" FontSize="9" FontWeight="Bold" Foreground="#FFAAA8D9" VerticalAlignment="Center"/><Button Content="×" DockPanel.Dock="Right" Width="34" Height="29" Background="Transparent" Foreground="#FFB4B7C6" BorderThickness="0" Click="Hide_Click"/></DockPanel></Border>
      <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#FF05050A"/>
      <Border x:Name="LoadingCard" Grid.Row="1" Background="#FF0A0B12" Visibility="Visible"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="50" Height="50" CornerRadius="17" Background="#FF201F37" BorderBrush="#558B83FF" BorderThickness="1"><TextBlock Text="S" FontSize="24" FontWeight="SemiBold" Foreground="#FFB8B2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Opening your private space" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/><TextBlock Text="Connecting to your conversations" FontSize="11" Foreground="#FF9296A9" HorizontalAlignment="Center"/></StackPanel></Border>
      <Border x:Name="LoginCard" Grid.RowSpan="2" Background="#F5090A10" Visibility="Collapsed"><Border Width="370" Padding="30" CornerRadius="18" Background="#FF151722" BorderBrush="#338B83FF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Welcome back" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Sign in once. Secret Chat will reconnect in the tray." FontSize="12" Foreground="#FF9296A9" Margin="0,6,0,22"/><TextBlock Text="USERNAME" FontSize="9" Foreground="#FFAAA8D9" Margin="0,0,0,5"/><TextBox x:Name="UsernameInput" Height="39" Padding="11,8" Background="#FF0C0D14" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"/><TextBlock Text="PASSWORD" FontSize="9" Foreground="#FFAAA8D9" Margin="0,14,0,5"/><PasswordBox x:Name="PasswordInput" Height="39" Padding="11,8" Background="#FF0C0D14" Foreground="White" BorderBrush="#30FFFFFF" BorderThickness="1"/><Button x:Name="LoginButton" Content="Continue" Height="42" Margin="0,20,0,0" Background="#FF7770EA" Foreground="White" BorderThickness="0" Click="Login_Click"/><TextBlock x:Name="LoginError" Foreground="#FFFF8585" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border></Border>
    </Grid>
  </Border>
</Window>
